#!/bin/sh
# Runs the commit-msg hook of the global core.hooksPath, when one is set.
# `make hooks` points this repo's core.hooksPath at .githooks, which hides the
# global hooks directory; this keeps its commit-msg check running.
set -eu

global="$(git config --global --get core.hooksPath 2>/dev/null || true)"
[ -n "$global" ] || exit 0
case "$global" in
\~/*) global="$HOME/${global#\~/}" ;;
esac
[ -d "$global" ] || exit 0

# A global hooksPath that is this directory would run this hook again.
here="$(cd "$(dirname "$0")" && pwd -P)"
[ "$(cd "$global" && pwd -P)" != "$here" ] || exit 0

hook="$global/commit-msg"
[ -x "$hook" ] || exit 0
exec "$hook" "$@"
